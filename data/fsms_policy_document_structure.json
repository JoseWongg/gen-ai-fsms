        {
          "subsection_id": "main_food_safety_hazards",
          "subsection_number": "2.3",
          "title": "Main Food Safety Hazards",
          "inclusion": "applicable_operational_content",
          "content_definitions": [
            {
              "content_key": "hazards_introduction",
              "block_type": "text",
              "role": "food_safety_importance",
              "text": "Based on the food activities carried out by the business, the principal hazards addressed within this FSMS are:"
            },
            {
              "content_key": "applicable_hazard_summary",
              "block_type": "list",
              "role": "food_safety_importance",
              "dynamic_sources": [
                "positive_conditions",
                "applicable_safety_point_rationales",
                "applicable_safety_point_text"
              ],
              "source_references": [
                "data/sfbb_chilling_cooking.json"
              ],
              "hazard_definitions": [
                {
                  "statement": "Harmful bacteria growing when chilled, cooling, reheated or hot-held food is not kept under suitable temperature control.",
                  "condition_ids": [
                    "chills_food",
                    "chills_hot_food",
                    "defrosts_food",
                    "reheats_food",
                    "hot_holds_food",
                    "displays_chilled_food",
                    "displays_hot_food"
                  ],
                  "safe_method_ids": [
                    "4.1",
                    "4.2",
                    "4.3",
                    "5.3",
                    "5.5"
                  ]
                },
                {
                  "statement": "Harmful bacteria surviving where food is not cooked or reheated thoroughly.",
                  "condition_ids": [
                    "cooks_food",
                    "reheats_food"
                  ],
                  "safe_method_ids": [
                    "5.1",
                    "5.2",
                    "5.3"
                  ]
                },
                {
                  "statement": "Cross-contamination between raw food and cooked or ready-to-eat food through hands, surfaces, utensils or equipment.",
                  "condition_ids": [
                    "handles_raw_meat_or_poultry",
                    "handles_ready_to_eat_food",
                    "uses_slicer"
                  ],
                  "safe_method_ids": [
                    "5.6"
                  ]
                },
                {
                  "statement": "Food becoming unsafe through unsuitable storage, poor date control, incorrect defrosting or loss of temperature control.",
                  "condition_ids": [
                    "chills_food",
                    "defrosts_food",
                    "freezes_food",
                    "buys_frozen_food",
                    "stores_food_that_must_be_kept_frozen",
                    "displays_chilled_food"
                  ],
                  "safe_method_ids": [
                    "4.1",
                    "4.3",
                    "4.4"
                  ]
                },
                {
                  "statement": "Food-specific hazards, including parasites in fish, natural toxins in dried pulses and safety risks associated with shellfish.",
                  "condition_ids": [
                    "handles_raw_fish",
                    "handles_raw_molluscs_or_crustaceans",
                    "cooks_dried_pulses"
                  ],
                  "safe_method_ids": []
                },
                {
                  "statement": "Increased acrylamide formation where bread, bakery or potato products are cooked too dark or at unsuitable temperatures.",
                  "condition_ids": [
                    "handles_bread_bakery_or_potatoes"
                  ],
                  "safe_method_ids": [
                    "5.4"
                  ]
                }
              ]
            }
          ]
        },
