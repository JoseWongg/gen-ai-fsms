      "inclusion": "approved_applicable_content",
      "source_section_ids": [
        "cooking"
      ],
      "content_definitions": [
        {
          "content_key": "cooking_section_introduction",
          "block_type": "text",
          "role": "introduction"
        },
        {
          "content_key": "cooking_overall_policy",
