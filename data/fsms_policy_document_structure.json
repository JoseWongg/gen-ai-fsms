      ],
      "subsections": [
        {
          "subsection_id": "cooking_safely",
          "subsection_number": "4.1",
          "title": "Cooking Safely",
          "inclusion": "approved_applicable_content",
          "source_safe_method_ids": [
            "5.1"
          ],
